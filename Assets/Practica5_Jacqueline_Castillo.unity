--- !u!114 &200036565
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 200036564}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d2c0a8f92e0d1244b019277ee9cb912, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  orden: 0100000002000000030000000400000005000000
  imageTargets:
  - {fileID: 234584058}
  - {fileID: 575234926}
  - {fileID: 1447863844}
  - {fileID: 401666367}
  - {fileID: 838949138}
  textoMision: {fileID: 1778254766}
  secuenciaEvento: {fileID: 1990510915}
  secuencias:
  - suceso: 1
    pasos:
    - imagen: {fileID: 21300000, guid: df25e61835c2f614b9372cc793d4a469, type: 3}
      mensaje: "Tomaste la espada de tu padre y sab\xEDas que no hab\xEDa vuelta
        atr\xE1s."
    - imagen: {fileID: 21300000, guid: 523225f779ff76e4495d7b437fe3c382, type: 3}
      mensaje: Cambiaste toda tu apariencia para parecer un hombre.
    - imagen: {fileID: 21300000, guid: 825ee4a4edf4e6d44a6349a89764a957, type: 3}
      mensaje: "Y te fuiste de casa, hacia el campamento del ej\xE9rcito."
  - suceso: 2
    pasos:
    - imagen: {fileID: 21300000, guid: e62cbd4e798e8bc498f44b3faf22ac1d, type: 3}
      mensaje: Lleguaste al campamento.
    - imagen: {fileID: 21300000, guid: 9c211d68962af7043b8d14e534f2eef3, type: 3}
      mensaje: "Has conocido a tu guardi\xE1n: Mushu. Dijo que te ayudar\xE1."
    - imagen: {fileID: 21300000, guid: f1d3ae5e6ef999444bc89d4bd363a5a1, type: 3}
      mensaje: "Entraste al campamento y comenz\xF3 tu entrenamiento."
    - imagen: {fileID: 21300000, guid: e0034aa2ebb52a64fab9910ac6af0338, type: 3}
      mensaje: 'Al principio eras un desastre, pero no te rendiste. Completaste tu
        entrenamiento. '
    - imagen: {fileID: 21300000, guid: e0034aa2ebb52a64fab9910ac6af0338, type: 3}
      mensaje: "Ahora debes unirte al campo de guerra. Directo a las monta\xF1as"
    - imagen: {fileID: 21300000, guid: df79c6715b6704d4abd6f276e1e3446d, type: 3}
      mensaje: Pero es demasiado tarde. El enemigo ha acabado con todos
    - imagen: {fileID: 21300000, guid: e8fbe7156354c6b4791b9adb214da464, type: 3}
      mensaje: "Y no solo eso, ahora son emboscados. Tienes que buscar los ca\xF1ones
        para defenderte."
  - suceso: 3
    pasos:
    - imagen: {fileID: 21300000, guid: f6df1da71f28ade4cba0f2cd92daa566, type: 3}
      mensaje: "Has encontrado el ca\xF1on y sabes perfectamente donde explotarlo."
    - imagen: {fileID: 21300000, guid: c7d57b8ef5d5e2e489b40beaffecd40e, type: 3}
      mensaje: "Apuntas hacia la monta\xF1a y usas a tu guard\xE1n para encenderlo."
    - imagen: {fileID: 21300000, guid: 97b08dde1c8881f4aafe9cbaa9103956, type: 3}
      mensaje: Logras hacer una avalancha y acabas con todos los enemigos.
    - imagen: {fileID: 21300000, guid: ffa97831d8bd9fe4fb9105c3a17345cd, type: 3}
      mensaje: Oh no! Fuiste herida
    - imagen: {fileID: 21300000, guid: da9d594d4a9a917438c76ad83104e912, type: 3}
      mensaje: Te llevan a curarte, pero descubren tu verdadera identidad. Te perdonan
        la vida, y te abandonan.
    - imagen: {fileID: 21300000, guid: 9aed9480c056a4d44aea367fd08c30f2, type: 3}
      mensaje: "Pero descubres que han sobrevivido los enemigos, tienes que ir a
        la Ciudad Imperial a advertirles a tus compa\xF1eros."
  - suceso: 4
    pasos:
    - imagen: {fileID: 21300000, guid: bc6a2ab957fe6c64a99df5eaad9c5e37, type: 3}
      mensaje: "Has llegado y les has advertido a tus compa\xF1eros. \xA1Pero no
        te creen!"
    - imagen: {fileID: 21300000, guid: 237fc391e3505a148a4cd21d54f77295, type: 3}
      mensaje: "No te escucharon. Ya hora es tarde. \xA1Han secuestrado al emperador!"
    - imagen: {fileID: 21300000, guid: 29565258c2e954e47871369acaf0e029, type: 3}
      mensaje: 'Tienes que ir tras su lider: Shan Yu. Y rescatar al emperador.'
  - suceso: 5
    pasos:
    - imagen: {fileID: 21300000, guid: 1e33869619b7d1e4c8712cf8142df03f, type: 3}
      mensaje: Logras salvar al emperador.
    - imagen: {fileID: 21300000, guid: 6cff34ad082a5f5429f4a5c63d4ed113, type: 3}
      mensaje: Te enfrentas a Shan Yu
    - imagen: {fileID: 21300000, guid: c957b24b51479cb42bba9995eaee9d6b, type: 3}
      mensaje: Y logras derrotarlo.
    - imagen: {fileID: 21300000, guid: 45e2cdf456e28d747bc3e1eef7cc17bf, type: 3}
      mensaje: Salvaste a todos, el emperador te da sus respetos.
    - imagen: {fileID: 21300000, guid: 57adbaf9d1573d546ab8adf8fe7098cf, type: 3}
      mensaje: "\xA1Lo lograste! Ahora eres la hero\xEDna de China."
  retrasoSecuencia: 3
